generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  email           String       @unique
  passwordHash    String
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  customer        Customer?
  userRoles       UserRole[]
  packagingRecords PackagingRecord[]
  auditLogs       AuditLog[]
  orderEvents     OrderStatusHistory[]
  deliveryEvents  DeliveryStatusHistory[]
  loginAttempts   AdminLoginAttempt[]

  @@index([isActive])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminLoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  ipHash      String
  userId      String?  @db.Uuid
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ipHash, attemptedAt])
  @@index([userId, attemptedAt])
}

model Customer {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String?               @unique @db.Uuid
  fullName    String
  email       String?
  phone       String
  customerType String               @default("INDIVIDUAL")
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses   CustomerAddress[]
  orders      Order[]
  invoices    Invoice[]
  creditTerms CustomerCreditTerms?
  returns     Return[]

  @@index([phone])
  @@index([email])
  @@index([fullName])
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  label        String?
  town         String
  address      String
  instructions String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault])
}

model CustomerCreditTerms {
  id                 String   @id @default(uuid()) @db.Uuid
  customerId         String   @unique @db.Uuid
  isApproved         Boolean  @default(false)
  creditLimit        Decimal  @default(0) @db.Decimal(12, 2)
  paymentTermDays    Int      @default(0)
  notes              String?
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String
  image       String
  category    String
  isActive    Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  variants    ProductVariant[]
  prices      ProductPrice[]
  orderItems  OrderItem[]
  inventories Inventory[]
  purchases   PurchaseItem[]
  returns     ReturnItem[]
  packaging   PackagingRecord[]

  @@index([category, isActive])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  label       String
  weightGrams Decimal      @db.Decimal(10, 3)
  unit        String       @default("g")
  isCustom    Boolean      @default(false)
  isActive    Boolean      @default(true)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices      ProductPrice[]
  orderItems  OrderItem[]
  inventories Inventory[]
  packaging   PackagingRecord[]

  @@unique([productId, label])
  @@index([productId, isActive])
}

model ProductPrice {
  id          String         @id @default(uuid()) @db.Uuid
  productId   String         @db.Uuid
  variantId   String?        @db.Uuid
  amount      Decimal        @db.Decimal(12, 2)
  validFrom   DateTime       @default(now()) @db.Timestamptz(3)
  validUntil  DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, validFrom, validUntil])
  @@index([variantId, validFrom, validUntil])
}

model Order {
  id                   String              @id @default(uuid()) @db.Uuid
  orderNumber          String              @unique
  customerId           String              @db.Uuid
  orderSource          String              @default("WEBSITE")
  paymentMethod        String?
  subtotal             Decimal             @db.Decimal(12, 2)
  deliveryFee          Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal             @db.Decimal(12, 2)
  orderStatus          String              @default("NEW")
  paymentStatus        String              @default("PENDING")
  deliveryAddress      String
  deliveryTown         String
  deliveryInstructions String?
  expectedDeliveryAt   DateTime            @db.Timestamptz(3)
  actualDeliveryAt     DateTime?           @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  payments             Payment[]
  statusHistory        OrderStatusHistory[]
  delivery             Delivery?
  returns              Return[]
  invoices             Invoice[]

  @@index([createdAt])
  @@index([orderStatus, expectedDeliveryAt])
  @@index([paymentStatus, createdAt])
  @@index([customerId, createdAt])
  @@index([orderSource, createdAt])
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @db.Uuid
  productId        String?         @db.Uuid
  variantId        String?         @db.Uuid
  productName      String
  variantName      String?
  quantity         Decimal         @db.Decimal(10, 3)
  unitPrice        Decimal         @db.Decimal(12, 2)
  subtotal         Decimal         @db.Decimal(12, 2)
  customQuantity   Boolean         @default(false)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  invoiceItems     InvoiceItem[]
  returnItems      ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  changedById String?  @db.Uuid
  fromStatus  String?
  toStatus    String
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  orderId          String?             @db.Uuid
  amount           Decimal             @db.Decimal(12, 2)
  paymentMethod    String
  paymentReference String?
  paymentStatus    String              @default("PENDING")
  paymentDate      DateTime?           @db.Timestamptz(3)
  notes            String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  chequeDetails    ChequeDetails?
  allocations      PaymentAllocation[]

  @@index([orderId, createdAt])
  @@index([paymentStatus, paymentDate])
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  invoiceId String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model ChequeDetails {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @unique @db.Uuid
  chequeNumber  String
  bankName      String?
  chequeDate    DateTime? @db.Date
  chequeStatus  String   @default("COLLECTED")
  clearedAt     DateTime? @db.Timestamptz(3)
  notes         String?
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([chequeStatus])
}

model Inventory {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @db.Uuid
  variantId      String?         @db.Uuid
  inventoryType  String          @default("BULK")
  trackingMode   String          @default("ON_HAND")
  unit           String          @default("g")
  onHand         Decimal         @default(0) @db.Decimal(12, 3)
  reorderLevel   Decimal         @default(0) @db.Decimal(12, 3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  batches        StockBatch[]
  movements      StockMovement[]
  packagingInput PackagingRecord[] @relation("PackagingInput")
  packagingOutput PackagingRecord[] @relation("PackagingOutput")

  @@index([productId, inventoryType])
  @@index([trackingMode])
}

model StockBatch {
  id                String          @id @default(uuid()) @db.Uuid
  inventoryId       String          @db.Uuid
  supplierId        String?         @db.Uuid
  batchNumber       String?
  quantityReceived  Decimal         @db.Decimal(12, 3)
  quantityRemaining Decimal         @db.Decimal(12, 3)
  unitCost          Decimal?        @db.Decimal(12, 2)
  receivedAt        DateTime        @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime?       @db.Date
  notes             String?
  inventory         Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  supplier          Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements         StockMovement[]
  packagingRecords  PackagingRecord[]

  @@index([inventoryId, receivedAt])
  @@index([expiresAt])
}

model StockMovement {
  id                String          @id @default(uuid()) @db.Uuid
  inventoryId       String          @db.Uuid
  batchId           String?         @db.Uuid
  movementType      String
  quantity          Decimal         @db.Decimal(12, 3)
  referenceType     String?
  referenceId       String?
  note              String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  inventory         Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  batch             StockBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
}

model PackagingRecord {
  id                   String          @id @default(uuid()) @db.Uuid
  productId            String          @db.Uuid
  variantId            String?         @db.Uuid
  inputInventoryId     String          @db.Uuid
  outputInventoryId    String?         @db.Uuid
  batchId              String?         @db.Uuid
  quantityPackaged     Decimal         @db.Decimal(12, 3)
  packagingSize        Decimal         @db.Decimal(12, 3)
  bulkStockConsumed    Decimal         @db.Decimal(12, 3)
  packagingLoss        Decimal         @default(0) @db.Decimal(12, 3)
  responsibleUserId    String?         @db.Uuid
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  product              Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant              ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  inputInventory       Inventory       @relation("PackagingInput", fields: [inputInventoryId], references: [id], onDelete: Restrict)
  outputInventory      Inventory?      @relation("PackagingOutput", fields: [outputInventoryId], references: [id], onDelete: SetNull)
  batch                StockBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  responsibleUser      User?           @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
}

model Supplier {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  purchases   Purchase[]
  batches     StockBatch[]

  @@index([name])
}

model Purchase {
  id          String        @id @default(uuid()) @db.Uuid
  supplierId  String        @db.Uuid
  reference   String?
  status      String        @default("RECEIVED")
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  purchasedAt DateTime      @default(now()) @db.Timestamptz(3)
  notes       String?
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items       PurchaseItem[]

  @@index([supplierId, purchasedAt])
}

model PurchaseItem {
  id             String   @id @default(uuid()) @db.Uuid
  purchaseId     String   @db.Uuid
  productId      String   @db.Uuid
  quantity       Decimal  @db.Decimal(12, 3)
  unitCost       Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
}

model Delivery {
  id              String                   @id @default(uuid()) @db.Uuid
  orderId         String                   @unique @db.Uuid
  status          String                   @default("SCHEDULED")
  assignedTo      String?
  actualDeliveredAt DateTime?              @db.Timestamptz(3)
  deliveryNotes   String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  order           Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  history         DeliveryStatusHistory[]

  @@index([status, createdAt])
}

model DeliveryStatusHistory {
  id          String   @id @default(uuid()) @db.Uuid
  deliveryId  String   @db.Uuid
  changedById String?  @db.Uuid
  fromStatus  String?
  toStatus    String
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([deliveryId, createdAt])
}

model Return {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  customerId  String       @db.Uuid
  status      String       @default("REQUESTED")
  reason      String
  resolution  String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items       ReturnItem[]
  replacement Replacement?

  @@index([status, createdAt])
}

model ReturnItem {
  id           String    @id @default(uuid()) @db.Uuid
  returnId     String    @db.Uuid
  orderItemId  String    @db.Uuid
  productId    String?   @db.Uuid
  quantity     Decimal   @db.Decimal(10, 3)
  condition    String?
  return       Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([returnId])
}

model Replacement {
  id          String   @id @default(uuid()) @db.Uuid
  returnId    String   @unique @db.Uuid
  orderNumber String?  @unique
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String              @id @default(uuid()) @db.Uuid
  invoiceNumber String            @unique
  customerId  String              @db.Uuid
  orderId     String?             @db.Uuid
  totalAmount Decimal             @db.Decimal(12, 2)
  status      String              @default("ISSUED")
  issuedAt    DateTime            @default(now()) @db.Timestamptz(3)
  dueAt       DateTime?           @db.Timestamptz(3)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@index([customerId, issuedAt])
  @@index([orderId])
  @@index([status, dueAt])
}

model InvoiceItem {
  id          String    @id @default(uuid()) @db.Uuid
  invoiceId   String    @db.Uuid
  orderItemId String?   @db.Uuid
  description String
  quantity    Decimal   @db.Decimal(10, 3)
  unitPrice   Decimal   @db.Decimal(12, 2)
  subtotal    Decimal   @db.Decimal(12, 2)
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
